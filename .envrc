# direnv config: run `direnv allow` once after cloning, and again after editing this file.
#
# Holds no secrets, so it's safe to commit. The DependencyTrack API key (the hand-made
# `tofu` team's) lives outside git in ~/.config/dependencytrack-config-terraform.env
# (mode 600), which sets:
#   export TF_VAR_dependencytrack_api_key=...   # lowercase: must match variable "dependencytrack_api_key"
#   export AWS_PROFILE=milanoid                 # S3 state backend
# CI gets the key from the repo secret TF_VAR_DEPENDENCYTRACK_API_KEY instead.

secrets_file="$HOME/.config/dependencytrack-config-terraform.env"

if [[ -f "$secrets_file" ]]; then
  # source_env also watches the file, so direnv reloads when it changes.
  source_env "$secrets_file"
else
  log_error "missing $secrets_file (see .envrc); tofu plan will prompt for the API key"
fi

# Fall back to the shared profile if the secrets file doesn't set one.
export AWS_PROFILE="${AWS_PROFILE:-milanoid}"

if [[ -z "${TF_VAR_dependencytrack_api_key:-}" ]]; then
  log_error "TF_VAR_dependencytrack_api_key is not set"
fi

# Run Claude Code on the personal account in this repo (the work account keeps the
# default ~/.claude). Only applies when `claude` is started from a direnv-loaded shell.
export CLAUDE_CONFIG_DIR="$HOME/.claude-personal"
